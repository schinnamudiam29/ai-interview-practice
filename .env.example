# Copy to .env.local for local development. Never commit real values.

# --- Local development without any accounts -------------------------------
# STORE_PROVIDER=memory      # in-process store, data lost on restart
# SANDBOX_PROVIDER=local     # runs tests with local python3, NO isolation (dev only)
# AI_PROVIDER=mock           # canned assistant replies, no API calls

# --- Database + auth (Supabase) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only

# --- Model ------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=                 # server only
AI_PRICE_INPUT_PER_M=0.25       # USD per 1M tokens, for the spend cap
AI_PRICE_OUTPUT_PER_M=1.5
DAILY_SPEND_CAP_USD=20          # assistant pauses for everyone when reached

# --- Code sandbox -----------------------------------------------------------
SANDBOX_PROVIDER=e2b
E2B_API_KEY=                    # server only
E2B_TEMPLATE=base

# --- Sessions -----------------------------------------------------------------
SESSION_SECRET=                 # 32+ random chars; signs guest cookies, hashes IPs
